.finance-pro,.staff-pro,.rules-pro{display:grid;gap:18px}.finance-top,.staff-head,.rules-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap}.finance-title,.staff-title,.rules-title{font-size:34px;font-weight:900;letter-spacing:-.045em}.finance-sub,.staff-sub,.rules-sub,.finance-section-sub{color:var(--mk-soft-text);font-size:14px;line-height:1.5;margin-top:5px}.finance-period{display:flex;gap:7px;flex-wrap:wrap}.finance-period button{border:1px solid var(--mk-border);background:var(--mk-panel);color:var(--mk-soft-text);border-radius:999px;padding:9px 13px;font-weight:900}.finance-period button.active{background:var(--mk-text);color:var(--mk-soft);border-color:var(--mk-text)}.finance-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.finance-card{padding:18px}.finance-kpi-label{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--mk-soft-text);font-weight:900;margin-bottom:10px}.finance-kpi-value{font-size:28px;font-weight:900;letter-spacing:-.02em}.finance-kpi-note{font-size:12px;color:var(--mk-soft-text);margin-top:8px}.finance-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px}.finance-section-title{font-size:23px;font-weight:900;letter-spacing:-.035em}.finance-table-wrap{overflow:auto;border:1px solid var(--mk-border);border-radius:18px;margin-top:12px}.finance-table{min-width:620px}.finance-money{font-weight:900;white-space:nowrap}.finance-muted{color:var(--mk-soft-text)!important}.finance-bars{display:grid;gap:10px;margin-top:12px}.finance-bar-row{display:grid;grid-template-columns:110px 1fr 85px;gap:12px;align-items:center;font-size:13px}.finance-bar{height:10px;border-radius:999px;background:rgba(27,166,64,.12);overflow:hidden}.finance-bar span{display:block;height:100%;background:var(--mk-green);border-radius:999px}.finance-form{display:grid;gap:10px}.finance-form-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.finance-expenses-list{display:grid;gap:10px;margin-top:14px}.finance-expense-item{border:1px solid var(--mk-border);border-radius:16px;background:var(--mk-panel);padding:12px}.finance-expense-item strong{font-size:14px}.finance-expense-item small{display:block;font-size:12px;color:var(--mk-soft-text);margin-top:3px}.staff-grid,.rules-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.staff-card,.rules-card{padding:18px}.staff-card h3{font-size:22px;margin-bottom:12px}.staff-list{display:grid;gap:10px}.staff-item{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;border:1px solid var(--mk-border);border-radius:18px;background:var(--mk-panel-2);padding:12px}.staff-item.active,.staff-item:hover{border-color:var(--mk-green);background:rgba(27,166,64,.08)}.staff-avatar{width:42px;height:42px;border-radius:50%;background:rgba(27,166,64,.13);display:grid;place-items:center;font-weight:900;color:var(--mk-green)}.staff-info strong{font-size:15px}.staff-info small{display:block;font-size:12px;color:var(--mk-soft-text);margin-top:3px}.staff-status{font-size:11px;font-weight:900;border-radius:999px;padding:6px 9px;background:rgba(27,166,64,.12);color:var(--mk-green)}.staff-status.off{background:rgba(101,103,96,.12);color:var(--mk-soft-text)}.staff-form{display:grid;gap:10px}.staff-form-row,.rules-form-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.staff-services-list{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.staff-service-toggle{display:flex;align-items:center;gap:8px;border:1px solid var(--mk-border);border-radius:14px;padding:10px;background:var(--mk-panel-2);font-size:13px;font-weight:800}.staff-service-toggle input,.mk-switch input,.hours-row input[type=checkbox]{accent-color:var(--mk-green)}.staff-hours-grid{display:grid;gap:8px}.staff-hours-row{display:grid;grid-template-columns:1.2fr .9fr .9fr;gap:8px;align-items:center;border:1px solid var(--mk-border);border-radius:14px;padding:8px;background:var(--mk-panel-2)}.staff-hours-row label{display:flex;align-items:center;gap:7px;font-weight:800;font-size:13px}.rule-switch{display:flex;justify-content:space-between;gap:12px;margin-bottom:14px}.rule-switch strong{font-size:20px;letter-spacing:-.03em}.rule-switch small{display:block;color:var(--mk-soft-text);font-size:13px;line-height:1.45;margin-top:3px}.mk-switch{position:relative;width:54px;height:31px;display:inline-block;flex:0 0 54px}.mk-switch input{display:none}.mk-switch span{position:absolute;inset:0;background:#d8d6cf;border-radius:999px}.mk-switch span:before{content:"";position:absolute;width:25px;height:25px;left:3px;top:3px;background:#fff;border-radius:50%;box-shadow:0 2px 8px rgba(0,0,0,.18);transition:.15s}.mk-switch input:checked+span{background:var(--mk-green)}.mk-switch input:checked+span:before{transform:translateX(23px)}.cover-upload{position:relative;height:150px;border:2px dashed var(--mk-border);border-radius:20px;display:grid;place-items:center;overflow:hidden;background:var(--mk-panel-2);cursor:pointer}.cover-upload img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.cover-upload input{display:none}.cover-upload-txt{text-align:center;color:var(--mk-soft-text)}.cover-upload-txt span{font-size:28px}.admin-notice{background:rgba(79,128,255,.1);border:1px solid rgba(79,128,255,.22);color:var(--mk-info);border-radius:16px;padding:12px 14px;margin-bottom:18px;font-weight:800}.mk-footer{display:none;background:#efeeeb;border-top:1px solid #e2e0da;margin-top:20px}.show-explore-footer .mk-footer,body:not(.admin-logged) .mk-footer{display:block}.mk-footer-inner{max-width:1280px;margin:0 auto;padding:58px clamp(18px,4vw,56px);display:grid;grid-template-columns:280px 1fr;gap:72px}.mk-footer-brand p{font-size:14px;color:#55574f;line-height:1.6;margin-top:18px}.footer-logo{display:flex;align-items:center;gap:10px}.mk-footer-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:36px}.mk-footer-grid h4{font-size:16px;margin-bottom:18px}.mk-footer-grid a{display:block;font-size:14px;margin-bottom:12px;color:#111}.mk-footer-bottom{border-top:1px solid #deddd8;max-width:1280px;margin:0 auto;padding:22px clamp(18px,4vw,56px);display:flex;justify-content:space-between;color:#60605a;font-size:13px;font-weight:750}.mk-footer-bottom span:first-child{color:var(--mk-green)}html.dark .mk-footer{background:#151815;border-top-color:var(--mk-border)}html.dark .mk-footer-grid a,html.dark .mk-footer-grid h4{color:#fff}html.dark .mk-footer-brand p,html.dark .mk-footer-bottom{color:var(--mk-soft-text)}
@media(max-width:1000px){.shops-grid{grid-template-columns:repeat(2,1fr)}.finance-kpis,.stats-row{grid-template-columns:repeat(2,1fr)}.finance-grid-2,.staff-grid,.rules-grid{grid-template-columns:1fr}}
@media(max-width:900px){body{padding-bottom:calc(112px + env(safe-area-inset-bottom))}.nav{height:72px;padding:0 12px;gap:8px;overflow:hidden}.logo-mark{width:38px;height:38px}.logo-text{font-size:24px}.nav-r{gap:6px}.theme-toggle{width:38px;height:38px;flex:0 0 38px}.nav-pill{height:38px;padding:0 11px;font-size:12px}.mk-hero-wrap{padding:24px 18px 18px}.mk-hero{display:block}.mk-hero h1{font-size:42px;line-height:1.02}.mk-hero p{font-size:15.5px}.mk-search{display:block;border-radius:22px}.mk-field{border-right:0;border-bottom:1px solid var(--mk-border);height:60px}.mk-current-location-btn{display:none}.mk-search-btn{width:100%;height:52px;margin-top:8px}.mk-hero-visual{display:none}.mk-trust-row{grid-template-columns:1fr 1fr;gap:14px}.mk-trust-item{font-size:12px}.mk-filters{padding:18px 18px 14px}.shops-wrap{padding:0 18px 100px}.shops-meta h2{font-size:28px}.mk-section-sub,.shops-meta span{display:none}.shops-grid{grid-template-columns:1fr;gap:14px}.shop-cover{height:220px}.bk-wrap,.my-bookings-wrap{padding:18px 14px 128px}.steps-bar{margin-bottom:18px}.stp-lbl{display:none}.sp-title{font-size:28px}.msvc-grid,.cal-layout{grid-template-columns:1fr}.slots-grid{grid-template-columns:repeat(2,1fr)}.slot{min-height:52px}.step-acts{position:fixed;left:0;right:0;bottom:calc(86px + env(safe-area-inset-bottom));z-index:850;padding:12px 14px;background:linear-gradient(to top,var(--mk-soft) 72%,rgba(247,246,241,0));margin:0}.my-bookings-form{display:grid}.dash-grid{display:block}.sidebar{display:none}.dash-main{padding:18px 14px 120px}.dash-title{font-size:30px}.dash-hdr{margin-bottom:16px}.dash-actions{width:100%;display:grid;grid-template-columns:1fr 1fr}.mkass-mobile-logout{grid-column:1/-1}.stat-c{padding:18px;min-height:120px}.t-card table{min-width:760px}.hub-card{border-radius:22px}.walkin-svc-check,.form-row-2,.finance-form-row,.staff-form-row,.rules-form-row,.staff-services-list{grid-template-columns:1fr}.balance-header{display:block}.balance-side{margin-top:14px}.finance-title,.staff-title,.rules-title{font-size:30px}.finance-kpis{grid-template-columns:1fr 1fr;gap:10px}.finance-card{border-radius:22px;padding:15px}.finance-kpi-value{font-size:24px}.finance-bar-row{grid-template-columns:90px 1fr 70px;gap:8px}.staff-hours-row{grid-template-columns:1fr 1fr}.staff-hours-row label{grid-column:1/-1}.pricing-grid,.signup-panel{grid-template-columns:1fr}.signup-screen{padding:28px 18px 120px}.signup-head{display:block}.mk-footer{display:none!important}.toast{left:14px;right:14px;bottom:106px}.modal{max-height:88vh}.modal-stats{gap:8px}.modal-total-bar{position:sticky;bottom:70px;z-index:1}.modal-book-btn{position:sticky;bottom:0;z-index:2}.api-badge{display:none}}
@media(max-width:520px){.stats-row,.finance-kpis,.mk-trust-row{grid-template-columns:1fr 1fr}.shop-row1{display:block}.shop-rating{margin-top:4px}.modal{padding:14px}.my-bookings-title{font-size:30px}.signup-title{font-size:38px}.plan-price{font-size:32px}.finance-period{width:100%;display:grid;grid-template-columns:1fr 1fr}.logo-text{font-size:22px}.nav-pill.signup-nav{display:none}}
