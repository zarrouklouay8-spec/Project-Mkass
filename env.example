:root{
  --mk-green:#1ba640;
  --mk-green-2:#168b35;
  --mk-soft:#f7f6f1;
  --mk-panel:#ffffff;
  --mk-panel-2:#fbfaf7;
  --mk-text:#101010;
  --mk-soft-text:#656760;
  --mk-border:#dedbd2;
  --mk-danger:#e55353;
  --mk-warn:#c97900;
  --mk-info:#4f80ff;
  --mk-shadow:0 18px 48px rgba(16,16,16,.07);
  color-scheme: light;
}
html.dark{
  --mk-soft:#0f1210;
  --mk-panel:#171b18;
  --mk-panel-2:#111512;
  --mk-text:#f6f6f1;
  --mk-soft-text:#b7b8b0;
  --mk-border:rgba(255,255,255,.14);
  --mk-shadow:none;
  color-scheme: dark;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body,#root{min-height:100%}
body{font-family:'Plus Jakarta Sans',Inter,Arial,sans-serif;background:var(--mk-soft);color:var(--mk-text);overflow-x:hidden;-webkit-font-smoothing:antialiased;padding-bottom:104px}
button,input,select,textarea{font-family:inherit}
button{cursor:pointer}
button:disabled{cursor:not-allowed;opacity:.55}
a{color:inherit;text-decoration:none}.clean-button{border:0;background:transparent;color:inherit;text-align:left}.view{min-height:calc(100vh - 76px);background:var(--mk-soft);animation:fadeIn .18s ease}@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.nav{height:76px;position:sticky;top:0;z-index:300;background:rgba(247,246,241,.94);backdrop-filter:blur(18px);border-bottom:1px solid rgba(16,16,16,.08);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(18px,4vw,56px)}
html.dark .nav{background:rgba(15,18,16,.92);border-bottom-color:rgba(255,255,255,.1)}
.logo{display:flex;align-items:center;gap:10px}.logo-mark{width:38px;height:38px;border-radius:11px;background:var(--mk-green);display:inline-grid;place-items:center;flex:0 0 38px}.logo-text{font-family:'Space Grotesk','Plus Jakarta Sans',Inter,sans-serif;font-weight:700;font-size:26px;letter-spacing:-.055em;line-height:1;color:var(--mk-text)}
.nav-r{display:flex;align-items:center;gap:10px}.theme-toggle{width:42px;height:42px;border-radius:50%;border:1px solid var(--mk-border);background:var(--mk-panel);display:grid;place-items:center}.theme-toggle:before{content:"";width:17px;height:17px;border-radius:50%;background:#111;box-shadow:inset -5px -3px 0 rgba(255,255,255,.75)}html.dark .theme-toggle:before{background:var(--mk-green);box-shadow:0 0 0 4px rgba(27,166,64,.14)}.nav-pill{height:42px;border-radius:999px;border:1px solid var(--mk-border);background:var(--mk-panel);color:var(--mk-text);font-weight:800;padding:0 16px}.signup-nav,.btn-lime,.mk-search-btn,.book-btn,.modal-book-btn{background:var(--mk-green)!important;border-color:var(--mk-green)!important;color:#07110b!important;font-weight:850!important}
.nav-tabs{position:fixed;left:14px;right:14px;bottom:max(14px,env(safe-area-inset-bottom));height:72px;z-index:9999;display:grid;grid-template-columns:repeat(3,1fr);gap:7px;padding:7px;border-radius:24px;background:rgba(16,16,16,.96);border:1px solid rgba(255,255,255,.14);box-shadow:0 18px 50px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,255,255,.05);backdrop-filter:blur(18px)}.ntab{border:0;border-radius:18px;background:transparent;color:#a8a8a2;font-size:13px;font-weight:850;display:flex;align-items:center;justify-content:center;text-align:center}.ntab.active{background:rgba(27,166,64,.18);color:var(--mk-green)}
.btn{min-height:44px;border-radius:14px;border:1px solid transparent;padding:0 18px;font-weight:850;display:inline-flex;align-items:center;justify-content:center;gap:8px}.btn-sm{min-height:38px;padding:0 13px;font-size:12px}.btn-ghost{background:transparent;border-color:var(--mk-border);color:var(--mk-text)}.btn-danger{background:rgba(229,83,83,.12);border-color:rgba(229,83,83,.22);color:var(--mk-danger)}.full{width:100%}.mt{margin-top:18px}.muted,.help-text{font-size:12px;color:var(--mk-soft-text);line-height:1.45;margin-top:6px}.section-label{font-size:11px;text-transform:uppercase;letter-spacing:.12em;font-weight:900;color:var(--mk-green);margin-bottom:10px}.empty-block{padding:24px;text-align:center;color:var(--mk-soft-text);font-size:14px}.api-badge{position:fixed;right:10px;bottom:6px;z-index:1;color:rgba(0,0,0,.28);font-size:10px}html.dark .api-badge{color:rgba(255,255,255,.2)}
.f-row{margin-bottom:14px}.f-label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.08em;font-weight:800;color:var(--mk-soft-text);margin-bottom:7px}.f-input{width:100%;min-height:48px;border:1px solid var(--mk-border);border-radius:14px;background:var(--mk-panel-2);color:var(--mk-text);padding:0 13px;font-size:14px;font-weight:600;outline:none}.f-input:focus{border-color:var(--mk-green);box-shadow:0 0 0 4px rgba(27,166,64,.12)}textarea.f-input{padding:12px 13px;resize:vertical}.form-row-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.toast{position:fixed;right:22px;bottom:100px;background:var(--mk-panel);border:1px solid var(--mk-border);border-left:4px solid var(--mk-green);box-shadow:0 18px 50px rgba(0,0,0,.16);border-radius:14px;padding:13px 16px;font-weight:800;font-size:13px;color:var(--mk-text);z-index:100000;opacity:0;transform:translateY(20px);pointer-events:none;transition:.22s}.toast.show{opacity:1;transform:none}.badge{display:inline-flex;align-items:center;gap:4px;padding:5px 10px;border-radius:999px;font-size:11px;font-weight:850;white-space:nowrap}.badge-open,.badge-confirmed{background:rgba(27,166,64,.14);color:var(--mk-green)}.badge-pending,.badge-busy{background:rgba(251,176,64,.14);color:var(--mk-warn)}.badge-cancelled,.badge-closed{background:rgba(229,83,83,.13);color:var(--mk-danger)}.badge-done{background:rgba(101,103,96,.12);color:var(--mk-soft-text)}.mini{font-size:9px;margin-left:6px;padding:3px 7px}
.mk-hero-wrap{max-width:1280px;margin:0 auto;padding:54px clamp(18px,4vw,56px) 28px}.mk-hero{display:grid;grid-template-columns:minmax(0,1.04fr) minmax(330px,.96fr);gap:46px;align-items:center}.mk-label{display:inline-flex;align-items:center;gap:9px;padding:8px 13px;background:var(--mk-panel);border:1px solid var(--mk-border);border-radius:999px;font-size:13px;font-weight:850;color:var(--mk-green);margin-bottom:24px}.mk-label span{width:8px;height:8px;border-radius:50%;background:var(--mk-green)}.mk-hero h1{font-size:clamp(44px,5.7vw,76px);line-height:.98;letter-spacing:-.055em;font-weight:800;margin-bottom:20px;max-width:720px}.mk-hero h1 em{font-style:normal;color:var(--mk-green)}.mk-hero p{font-size:18px;line-height:1.6;color:var(--mk-soft-text);max-width:550px;margin-bottom:30px}.mk-search{background:var(--mk-panel);border:1px solid var(--mk-border);border-radius:24px;box-shadow:0 28px 70px rgba(28,36,30,.12);padding:8px;display:grid;grid-template-columns:1fr 1fr auto;align-items:center;max-width:780px}.mk-field{height:58px;display:flex;align-items:center;gap:13px;padding:0 17px;border-right:1px solid var(--mk-border)}.mk-field:last-of-type{border-right:0}.mk-field-body{flex:1;min-width:0}.mk-field small{display:block;font-size:11px;color:var(--mk-soft-text);font-weight:800;text-transform:uppercase;letter-spacing:.08em}.mk-field input{border:0;background:transparent;outline:0;color:var(--mk-text);font-size:15px;font-weight:650;width:100%;margin-top:3px}.mk-search-btn{height:58px;border:0;border-radius:18px;padding:0 26px;font-size:15px}.mk-current-location-btn{border:0;background:rgba(27,166,64,.12);color:var(--mk-green);font-weight:850;font-size:12px;border-radius:999px;padding:8px 10px;white-space:nowrap}.mk-icon{width:22px;height:22px;position:relative;opacity:.85;flex:0 0 22px}.mk-search-ico:before{content:"";position:absolute;left:2px;top:2px;width:12px;height:12px;border:2px solid currentColor;border-radius:50%}.mk-search-ico:after{content:"";position:absolute;left:14px;top:15px;width:8px;height:2px;background:currentColor;transform:rotate(45deg);border-radius:2px}.mk-pin:before{content:"";position:absolute;left:5px;top:2px;width:12px;height:12px;border:2px solid currentColor;border-radius:50%}.mk-pin:after{content:"";position:absolute;left:10px;top:15px;width:2px;height:6px;background:currentColor}.mk-hero-visual{height:520px;border-radius:34px;overflow:hidden;position:relative;background:#ddd;box-shadow:0 30px 90px rgba(0,0,0,.13)}.mk-hero-visual img{width:100%;height:100%;object-fit:cover}.mk-floating-card{position:absolute;left:22px;right:22px;bottom:22px;background:rgba(255,255,255,.92);backdrop-filter:blur(18px);border-radius:24px;padding:16px;display:flex;align-items:center;justify-content:space-between;gap:16px;color:#111}.mk-floating-card h3{font-size:17px;margin-bottom:4px}.mk-floating-card p{font-size:13px;color:#666}.mk-rating{font-weight:900;color:#111}.mk-floating-card button{height:44px;border:0;border-radius:14px;padding:0 16px;background:var(--mk-green);font-weight:850}.mk-trust-row{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:28px}.mk-trust-item{display:flex;align-items:center;gap:11px;color:var(--mk-soft-text);font-size:14px;font-weight:800}.mk-trust-item span{width:28px;height:28px;border-radius:50%;background:rgba(27,166,64,.12);position:relative}.mk-trust-item span:after{content:"";position:absolute;left:9px;top:7px;width:8px;height:12px;border-right:2px solid var(--mk-green);border-bottom:2px solid var(--mk-green);transform:rotate(40deg)}.chips{display:flex;gap:10px;overflow:auto;scrollbar-width:none}.mk-filters{max-width:1280px;margin:0 auto;padding:24px clamp(18px,4vw,56px) 18px}.chip{border:1px solid var(--mk-border);background:var(--mk-panel);border-radius:999px;padding:11px 15px;font-size:14px;font-weight:800;white-space:nowrap;color:var(--mk-text)}.chip.active{background:var(--mk-green);border-color:var(--mk-green);color:#07110b}.shops-wrap{max-width:1280px;margin:0 auto;padding:0 clamp(18px,4vw,56px) 58px}.shops-meta{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:18px;gap:16px}.shops-meta h2{font-size:34px;letter-spacing:-.04em;font-weight:800}.mk-section-sub,.shops-meta span{font-size:14px;color:var(--mk-soft-text);font-weight:750;margin-top:5px}.shops-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.shop-card{background:var(--mk-panel);border:1px solid var(--mk-border);border-radius:26px;overflow:hidden;box-shadow:var(--mk-shadow);transition:.18s}.shop-card:hover{transform:translateY(-2px)}.shop-cover{height:230px;background:#ddd;position:relative;overflow:hidden}.shop-cover img{width:100%;height:100%;object-fit:cover}.shop-cover-placeholder{width:100%;height:100%;display:grid;place-items:center;font-size:58px;background:linear-gradient(135deg,#e8dfd5,#f7f6f1)}.cover-badge{position:absolute;top:12px;right:12px}.cover-dist{position:absolute;left:12px;bottom:12px;background:rgba(17,17,17,.82);color:#fff;border-radius:999px;padding:8px 11px;font-size:12px;font-weight:900}.shop-body{padding:16px}.shop-row1{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:4px}.shop-name{font-size:20px;font-weight:800;letter-spacing:-.02em}.shop-rating{font-size:13px;font-weight:800}.star,.rev-stars,.gold-star{color:#f5b301}.review-count{color:var(--mk-soft-text)}.shop-type-lbl,.shop-from{font-size:13px;font-weight:600;color:var(--mk-soft-text);margin-bottom:12px}.shop-tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}.shop-tag{background:var(--mk-panel-2);border-radius:999px;padding:7px 9px;font-size:12px;font-weight:750;color:var(--mk-text)}.shop-tag.lime{background:rgba(27,166,64,.12);color:var(--mk-green)}.shop-foot{display:flex;align-items:center;justify-content:space-between;gap:12px}.book-btn{height:42px;border:0;border-radius:14px;padding:0 16px;font-size:14px}
.overlay{position:fixed;inset:0;z-index:5000;background:rgba(0,0,0,.65);display:flex;align-items:flex-end;justify-content:center;padding:0 14px}.modal{width:min(660px,100%);max-height:90vh;overflow:auto;background:var(--mk-panel);color:var(--mk-text);border:1px solid var(--mk-border);border-radius:28px 28px 0 0;padding:18px;box-shadow:0 28px 90px rgba(0,0,0,.34)}.modal-handle{width:70px;height:28px;margin:0 auto 12px;display:flex;align-items:center;justify-content:center}.modal-handle:before{content:"";width:42px;height:4px;border-radius:999px;background:var(--mk-soft-text)}.modal-cover{height:190px;border-radius:20px;overflow:hidden;background:var(--mk-panel-2);display:grid;place-items:center;margin-bottom:16px}.modal-cover img{width:100%;height:100%;object-fit:cover}.modal-cover-ph{font-size:72px}.modal-hdr{display:flex;gap:12px;align-items:flex-start;margin-bottom:16px}.modal-icon{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;font-size:26px;flex:0 0 52px}.modal-title{font-size:22px;font-weight:900;letter-spacing:-.035em}.modal-addr{font-size:12px;color:var(--mk-soft-text);margin-top:5px;display:block}.map-link:hover{color:var(--mk-green);text-decoration:underline}.modal-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px}.mstat{background:var(--mk-panel-2);border:1px solid var(--mk-border);border-radius:16px;padding:13px;text-align:center}.mstat-val{font-size:20px;font-weight:900}.mstat-val.lime{color:var(--mk-green)}.mstat-lbl{font-size:11px;color:var(--mk-soft-text);margin-top:3px}.modal-svcs-title,.reviews-lbl{font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;color:var(--mk-soft-text);margin:18px 0 10px}.modal-svc-list{display:grid;gap:8px}.modal-svc-item{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid var(--mk-border);border-radius:14px;background:var(--mk-panel);padding:11px 13px}.modal-svc-item.picked{border-color:var(--mk-green);background:rgba(27,166,64,.08)}.modal-svc-left{display:flex;align-items:center;gap:10px}.modal-svc-check{width:22px;height:22px;border:1px solid var(--mk-border);border-radius:50%;display:grid;place-items:center;font-size:11px}.picked .modal-svc-check{background:var(--mk-green);border-color:var(--mk-green);color:#07110b}.modal-svc-name,.modal-svc-dur{display:block}.modal-svc-name{font-size:14px;font-weight:800}.modal-svc-dur{font-size:11px;color:var(--mk-soft-text);margin-top:2px}.modal-svc-price{font-size:15px;font-weight:900;color:var(--mk-green);white-space:nowrap}.modal-total-bar,.sel-summary,.total-display{background:rgba(27,166,64,.1);border:1px solid rgba(27,166,64,.22);border-radius:16px;padding:12px 14px;display:flex;justify-content:space-between;gap:12px;margin:14px 0}.modal-total-bar strong,.total-display strong{color:var(--mk-green)}.modal-book-btn{width:100%;min-height:56px;border:0;border-radius:18px;font-size:16px}.review{border-top:1px solid var(--mk-border);padding:14px 0}.review:first-of-type{border-top:0}.rev-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px}.rev-person{display:flex;align-items:center;gap:8px}.rev-av{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;font-size:12px;font-weight:900;color:#07110b}.rev-name{font-size:13px;font-weight:800}.rev-date,.rev-text{font-size:12px;color:var(--mk-soft-text);line-height:1.6}.review-modal{max-width:520px}
.bk-wrap,.my-bookings-wrap{max-width:900px;margin:0 auto;padding:32px 18px 120px}.bk-salon-bar,.card,.cal-box,.slots-box,.login-card,.signup-card,.pay-card,.my-bookings-hero,.booking-card,.t-card,.stat-c,.walkin-panel,.add-svc-form,.settings-form,.new-salon-form,.balance-header,.svc-manage-card,.finance-card,.staff-card,.rules-card{background:var(--mk-panel);border:1px solid var(--mk-border);border-radius:24px;box-shadow:var(--mk-shadow);color:var(--mk-text)}.bk-salon-bar{display:flex;gap:12px;align-items:center;padding:16px 18px;margin-bottom:24px}.bk-salon-icon{width:48px;height:48px;border-radius:14px;background:var(--mk-panel-2);display:grid;place-items:center;font-size:24px}.bk-salon-name{font-size:17px;font-weight:900}.bk-salon-addr{font-size:12px;color:var(--mk-soft-text);margin-top:3px}.steps-bar{display:flex;align-items:center;margin-bottom:24px}.stp{display:flex;align-items:center;gap:7px}.stp-n{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--mk-border);font-size:12px;font-weight:900;color:var(--mk-soft-text)}.stp.active .stp-n{background:var(--mk-green);border-color:var(--mk-green);color:#07110b}.stp.done .stp-n{background:var(--mk-panel-2);color:var(--mk-text)}.stp-lbl{font-size:12px;color:var(--mk-soft-text);font-weight:700}.stp.active .stp-lbl{color:var(--mk-text)}.stp-line{height:1px;background:var(--mk-border);flex:1;margin:0 8px}.sp-title{font-size:30px;font-weight:900;letter-spacing:-.04em;margin-bottom:16px}.msvc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:10px}.msvc-card{position:relative;padding:18px;border:1.5px solid var(--mk-border);border-radius:20px;background:var(--mk-panel);display:flex;flex-direction:column;align-items:flex-start;gap:3px;min-height:118px}.msvc-card.picked{border-color:var(--mk-green);background:rgba(27,166,64,.08)}.msvc-chk{position:absolute;top:10px;right:10px;width:22px;height:22px;border-radius:50%;border:1px solid var(--mk-border);display:grid;place-items:center;color:transparent}.picked .msvc-chk{background:var(--mk-green);border-color:var(--mk-green);color:#07110b}.msvc-cat{font-size:10px;text-transform:uppercase;letter-spacing:.08em;font-weight:900;color:var(--mk-soft-text)}.msvc-name{font-size:15px;font-weight:900}.msvc-dur{font-size:12px;color:var(--mk-soft-text)}.msvc-price{margin-top:auto;color:var(--mk-green);font-size:20px;font-weight:900}.msvc-price small{font-size:12px;color:var(--mk-soft-text)}.sel-summary{display:block}.sel-summary-row{display:flex;justify-content:space-between;gap:12px;font-size:13px;padding:4px 0}.sel-summary-row.total{border-top:1px solid rgba(27,166,64,.2);margin-top:6px;padding-top:8px;font-weight:900}.sel-summary-row.total span:last-child{color:var(--mk-green)}.staff-selector{background:var(--mk-panel);border:1px solid var(--mk-border);border-radius:22px;padding:14px;margin:14px 0}.staff-selector-title{font-size:18px;font-weight:900}.staff-selector-sub{font-size:13px;color:var(--mk-soft-text);margin:4px 0 12px}.staff-choice-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px}.staff-choice{border:1px solid var(--mk-border);background:var(--mk-panel-2);border-radius:16px;min-height:52px;padding:10px 12px;font-weight:900;color:var(--mk-text)}.staff-choice small{display:block;font-weight:650;color:var(--mk-soft-text);margin-top:3px}.staff-choice.active{border-color:var(--mk-green);background:rgba(27,166,64,.12);color:var(--mk-green)}.cal-layout{display:grid;grid-template-columns:1fr 1fr;gap:14px}.cal-box,.slots-box{padding:18px}.cal-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.cal-month{font-size:15px;font-weight:900}.cal-arr{width:32px;height:32px;border-radius:10px;border:1px solid var(--mk-border);background:transparent;color:var(--mk-text);font-size:18px}.cal-wds,.cal-days{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}.cal-wd{text-align:center;font-size:10px;text-transform:upper