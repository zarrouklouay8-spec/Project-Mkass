.dash-grid{display:grid;grid-template-columns:240px 1fr;min-height:calc(100vh - 76px)}.sidebar{background:var(--mk-panel);border-right:1px solid var(--mk-border);padding:18px 12px;display:flex;flex-direction:column;gap:4px}.sb-lbl{font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:900;color:var(--mk-soft-text);padding:8px 10px}.sb-btn{width:100%;min-height:42px;border:0;background:transparent;color:var(--mk-soft-text);border-radius:14px;display:flex;align-items:center;gap:8px;justify-content:flex-start;padding:0 11px;font-weight:800}.sb-btn:hover{background:var(--mk-panel-2);color:var(--mk-text)}.sb-btn.active{background:rgba(27,166,64,.14);color:var(--mk-green)}.sb-btn.locked{opacity:.65}.sb-badge,.lock-pill,.pro-badge{margin-left:auto;background:rgba(27,166,64,.14);color:var(--mk-green);border-radius:999px;padding:4px 8px;font-size:10px;font-weight:900}.sidebar-bottom{margin-top:auto;padding-top:16px;border-top:1px solid var(--mk-border);font-size:12px;color:var(--mk-soft-text)}#sb-salon-lbl{padding:8px 10px}.dash-main{padding:32px;overflow-x:hidden}.dash-hdr{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:22px;flex-wrap:wrap}.dash-title{font-size:32px;font-weight:900;letter-spacing:-.045em}.dash-sub{font-size:14px;color:var(--mk-soft-text);margin-top:5px}.dash-actions{display:flex;gap:8px;flex-wrap:wrap}.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px}.stat-c{padding:20px}.stat-lbl{font-size:11px;text-transform:uppercase;letter-spacing:.08em;font-weight:900;color:var(--mk-soft-text);margin-bottom:10px}.stat-val{font-size:34px;font-weight:900}.stat-val.lime,.balance-amount,.smc-price,.finance-kpi-value.green,.finance-positive{color:var(--mk-green)}.stat-val.warn{color:var(--mk-warn)}.stat-val.info{color:var(--mk-info)}.stat-sub{font-size:12px;color:var(--mk-soft-text);margin-top:4px}.t-card{overflow:auto}table{width:100%;border-collapse:collapse}th{background:var(